rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // DEFAULT: Deny all access
    // Overridden by specific match blocks below.
    // This ensures any unlisted collection is denied by default.
    // ============================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ============================================================
    // users/{userId}
    // Registration & user profile documents.
    // Document ID = Firebase Auth UID.
    //
    // - Authenticated user can read only their own document.
    // - Client-side writes are denied always.
    //   User creation/updates happen server-side via Firebase Admin SDK
    //   (which bypasses these security rules), or via Firebase Auth
    //   onCreate trigger calling a Backend service.
    // ============================================================
    match /users/{userId} {
      // Read: only the authenticated owner
      allow read: if request.auth != null
                   && request.auth.uid == userId;

      // Write: denied from client side.
      // Admin SDK writes bypass rules; Auth onCreate triggers handle
      // initial user document creation server-side.
      allow create, update, delete: if false;
    }

  }
}